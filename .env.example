# Assistant Configuration
ASSISTANT_NAME=Jarvis

# Telegram Bot Configuration
TELEGRAM_TOKEN=

# Telegram Whitelist (comma-separated user IDs, first is master)
WHITE_LIST=

# Azure OpenAI Configuration
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT_NAME=

# Optional: Google Search Integration
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional: MCP Server (Home Assistant, etc.)
MCP_HOST_URL=
MCP_AUTH_TOKEN=
ENABLE_MCP_SERVER=false

# System Configuration
PERSISTENCE_PATH=./persist/
DEBUG_LEVEL=INFO
TEMPERATURE=0.7

# Container Configuration (optional overrides)
CONTAINER_IMAGE=nanoclaw-agent:latest
CONTAINER_TIMEOUT=300000
MAX_CONCURRENT_CONTAINERS=5
